* text=auto

# 源码 / 配置 / 文档：仓库内统一 LF（避免 Windows 上 core.autocrlf 带来的 diff 噪声）
*.ts    text eol=lf
*.tsx   text eol=lf
*.js    text eol=lf
*.mjs   text eol=lf
*.css   text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf

# Windows 脚本：保持 CRLF（PowerShell 5.1 / cmd 更稳妥）
*.ps1   text eol=crlf
*.bat   text eol=crlf
*.cmd   text eol=crlf

# 二进制：不做行尾转换、不参与文本 diff
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.woff  binary
*.woff2 binary
*.db    binary

# 生成文件：折叠进 diff 统计
pnpm-lock.yaml  -diff linguist-generated
